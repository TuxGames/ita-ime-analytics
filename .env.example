# Copie para .env e preencha. NUNCA commite o .env.

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Em produção (PythonAnywhere, HTTPS) deixe true. Em dev local (http://127.0.0.1) use false,
# senão o cookie de sessão não é enviado e o login não funciona.
SESSION_COOKIE_SECURE=true

# true no PythonAnywhere (app roda atrás de proxy reverso; necessário para o
# rate limiting por IP enxergar o IP real e não o do proxy)
BEHIND_PROXY=true

# Timeout da sessão em horas (padrão 12)
SESSION_HOURS=12
